# =============================================================================
# KernelSU-Next configuration fragment
# =============================================================================
# Mirrors ExtremeKRNL's ksu.config (milxnaq/android_kernel_samsung_s5e9925,
# arch/arm64/configs/ksu.config), proven working on this SoC/kernel generation
# (s5e9925, Linux 5.10 GKI).
#
# Requires the KernelSU-Next driver to be vendored into the kernel tree first -
# the "Set up KernelSU-Next" workflow step does this via the official setup.sh.
# =============================================================================

CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set

# KernelSU-Next hooks syscalls via kprobes on GKI kernels. Samsung's 5.10
# config normally has these on already; kept here as a safety net since
# merge_config treats duplicates as harmless.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
