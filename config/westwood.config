# =============================================================================
# RushKernel "westwood" build variant - config fragment
# =============================================================================
# Referenced by .github/workflows/build-kernel.yml (build_variant: westwood).
# This file was previously missing, so that variant failed immediately with
# "cp: cannot stat '../config/westwood.config'".
#
# Purpose: a lighter-weight alternative to rushkernel-full - only swaps the
# default TCP congestion control to Westwood+, which is tuned for links with
# random (non-congestive) packet loss, e.g. cellular. No memory/VPN changes.
#
# Symbol names verified against net/ipv4/Kconfig for this kernel generation.
# =============================================================================

# -----------------------------------------------------------------------------
# Network: TCP Westwood+ congestion control
# -----------------------------------------------------------------------------
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_DEFAULT_TCP_CONG="westwood"

# -----------------------------------------------------------------------------
# Branding: Kernel local version
# -----------------------------------------------------------------------------
CONFIG_LOCALVERSION="-Westwood"
CONFIG_LOCALVERSION_AUTO=n
